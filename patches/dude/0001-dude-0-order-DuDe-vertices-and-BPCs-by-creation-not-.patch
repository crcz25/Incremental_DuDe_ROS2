+// PATCH(dude-0): pocket size, then creation order of the kid
+static bool kid_order(const pair<int, c_BPC *> &a, const pair<int, c_BPC *> &b) {
+  if (a.first != b.first)
+    return a.first < b.first;
+  return a.second->seq.value < b.second->seq.value;
+}
